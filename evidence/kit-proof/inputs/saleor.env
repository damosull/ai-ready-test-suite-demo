# repo-check proof run: the demo's Saleor Dashboard repository, held-out ticket 07.
REPO="$HOME/Projects/ai-ready-test-suite-demo"
BASE_REF=28bf90d                              # the Saleor import commit (upstream 77dc49b), nothing of the demo's
APP_NAME="the Saleor Dashboard"
APP_NOUN=dashboard

TICKETS_DIR="$HOME/.cache/ai-ready-demo/kit-proof/tickets"
BREAKS_DIR="$HOME/.cache/ai-ready-demo/kit-proof/breaks"
CHECKLIST="$HOME/.cache/ai-ready-demo/kit-proof/CHECKLIST.md"
CONVENTIONS="$HOME/.cache/ai-ready-demo/kit-proof/CONVENTIONS.md"
SETUP_REF=with-setup-frozen-v1
TICKETS="07"

PW_CONFIG=e2e/playwright.config.ts
PW_PROJECT=stable
TESTS_DIR=e2e/tests
E2E_DIR=e2e
SRC_DIR=src
HELPER_DIRS="\`e2e/pages/\`, \`e2e/lib/\` and \`e2e/scenarios/\`"
SPEC_PATHSPEC='e2e/tests/*.spec.ts'
SPEC_STRIP="e2e/"
TEST_CMD="pnpm e2e"
TYPECHECK_CMD="pnpm run --silent check-types:e2e"
STACK_START="pnpm e2e tests/login.spec.ts --workers=1 --reporter=line"
STACK_STOP="pnpm e2e:down"
STACK_NOTE="The suite's own runner starts the stack (Saleor in Docker, dashboard on http://localhost:9200) from the Playwright config's global setup."

SESSION_BASH="Bash(pnpm e2e:*) Bash(pnpm run check-types:e2e) Bash(pnpm exec playwright:*) Bash(pnpm exec oxlint:*) Bash(pnpm exec prettier:*)"
PROTECT="package.json pnpm-*.yaml e2e/run.ts e2e/playwright.config.ts e2e/global-setup.ts .claude/settings*.json .mcp.json"
# The frozen setup branch carries the demo's method files; the demo hid these from its sessions too.
HIDE="SCORING.md RESULTS.md HANDOFF.md demo evidence tickets"

FREE_SEED="$HOME/.cache/ai-ready-demo/kit-proof/seed.spec.ts"
CONVENTIONS_FILE=AGENTS.md

OUT="$HOME/.cache/ai-ready-demo/kit-proof/out"
RUNS=3
REPEATS=20
MODEL=opus
PREFIX=repo-check
SIDES="free ai-conventions setup"
